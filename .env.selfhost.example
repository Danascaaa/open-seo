# OpenSEO Cloudflare self-host. Walkthrough: docs/SELF_HOSTING_CLOUDFLARE_ALCHEMY.md

# ---------- Required ----------

# Get one at https://dataforseo.com — see docs/DATAFORSEO_API_KEY.md
DATAFORSEO_API_KEY=

# Who may sign in through Cloudflare Access, comma-separated
ACCESS_ALLOWED_EMAILS=

# Required by this fork: central budget ledger. Paid calls fail closed when
# either value is missing or the ledger cannot reserve the operation.
SEO_LEDGER_BASE_URL=
SEO_LEDGER_TOKEN=

# Reviewed maximum cost in euro cents for every enabled paid operation. Any
# missing operation is disabled before provider dispatch. Keep `{}` until
# current vendor tariffs and request caps have been reviewed.
SEO_PAID_OPERATION_LIMITS_JSON={}

# Dedicated automation identity. The token reaches /mcp only; both allowlists
# are enforced server-side on tools/list and every tools/call.
OPENSEO_SERVICE_TOKEN=
OPENSEO_SERVICE_EMAIL=
OPENSEO_SERVICE_PROJECT_IDS=
OPENSEO_SERVICE_TOOLS=

# ID of an existing Cloudflare Access Service Token. Alchemy creates a
# machine-only Access application for the exact /mcp path. Store the token's
# client ID and one-time client secret in the scheduler vault.
CF_ACCESS_SERVICE_TOKEN_ID=

# ---------- Optional — uncomment to use ----------

# Google Search Console (all three together) — docs/SELF_HOSTING_GOOGLE_SEARCH_CONSOLE.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_SECRET=

# SAM, the in-app agent (hidden if unset)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Your own PostHog product analytics
# POSTHOG_PUBLIC_KEY=
# POSTHOG_HOST=

# Opt out of anonymized telemetry — docs/SELF_HOSTING_CLOUDFLARE_OPERATIONS.md
# OPENSEO_TELEMETRY_DISABLED=1

# Bring your own Cloudflare Access application instead of the auto-provisioned
# one (ACCESS_ALLOWED_EMAILS is then ignored)
# TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# POLICY_AUD=your-access-application-audience-tag
